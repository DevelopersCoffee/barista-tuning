{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge-intelligence.local/schemas/pack-manifest/v1/schema.json",
  "title": "Pack Manifest 1.0",
  "type": "object",
  "required": ["pack", "compiler", "runtime", "schema", "capabilities", "checksum"],
  "additionalProperties": false,
  "properties": {
    "pack": {
      "type": "object",
      "required": ["id", "name", "version", "domain", "provider"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "domain": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 }
      }
    },
    "compiler": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["minimum_sdk"],
      "additionalProperties": false,
      "properties": {
        "minimum_sdk": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "schema": {
      "type": "object",
      "required": ["pack_schema", "domain_ir", "migration"],
      "additionalProperties": false,
      "properties": {
        "pack_schema": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "domain_ir": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "migration": { "type": "integer", "minimum": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checksum": { "type": "string", "minLength": 1 },
    "signature": { "type": ["object", "null"], "additionalProperties": true }
  }
}

