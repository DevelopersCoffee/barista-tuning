{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edge-intelligence.local/schemas/airo-media-actions/v1/schema.json",
  "title": "Airo Media Action 1.0",
  "type": "object",
  "required": [
    "intent",
    "tool",
    "confidence",
    "constraints",
    "missing_fields",
    "clarification_required"
  ],
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["search", "play", "recommend", "resume", "browse", "favorite", "history", "clarify"]
    },
    "tool": {
      "type": "string",
      "enum": [
        "media.search",
        "media.play",
        "media.recommend",
        "media.resume",
        "media.browse",
        "media.favorite",
        "media.history",
        "media.clarify"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "constraints": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "clarification_required": {
      "type": "boolean"
    }
  }
}

